---
/**
 * El panel de AoE2C (dashboard), rehecho en HTML: barra lateral, números de la guía
 * activa y la evolución del tiempo a Castillos, que se dibuja al llegar con el scroll.
 */
import T from "./T.astro";

// Partidas de ejemplo: minutos hasta Castillos.
const tiempos = [19.67, 19.1, 18.85, 18.33, 18.6, 17.9, 17.5, 17.68, 17.1, 16.85, 16.5, 16.2];
const W = 520, H = 170, P = 14;
const min = 15.8, max = 20;
const px = (i: number) => P + (i * (W - 2 * P)) / (tiempos.length - 1);
const py = (v: number) => P + ((max - v) / (max - min)) * (H - 2 * P);
const linea = tiempos.map((v, i) => `${i ? "L" : "M"}${px(i).toFixed(1)} ${py(v).toFixed(1)}`).join(" ");
const area = `${linea} L${px(tiempos.length - 1)} ${H} L${px(0)} ${H}Z`;
const meta = py(15.92);

const menu = [
  { es: "Inicio", en: "Home", d: '<path d="M4 11 12 4l8 7v9H4z"/>' },
  { es: "Estadísticas", en: "Statistics", d: '<path d="M4 19V5M4 19h16"/><path d="m7 15 4-4 3 3 5-6"/>' },
  { es: "Guías", en: "Guides", d: '<path d="M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3z"/>' },
  { es: "Mapas", en: "Maps", d: '<path d="m3 6 6-2 6 2 6-2v14l-6 2-6-2-6 2z"/><path d="M9 4v14M15 6v14"/>' },
  { es: "MODs", en: "MODs", d: '<path d="M12 3 4 7v10l8 4 8-4V7z"/><path d="m4 7 8 4 8-4M12 11v10"/>' },
  { es: "Ajustes", en: "Settings", d: '<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9 7 7M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1"/>' },
];

const extras = [
  {
    es: ["Historial y estadísticas", "Cada partida queda guardada en tu PC con su repetición. Ve tu mejor marca, tu media y el paso donde más tiempo pierdes."],
    en: ["History and statistics", "Every game is saved on your PC with its replay. See your best time, your average and the step where you lose the most time."],
    d: '<path d="M4 19V5M4 19h16"/><path d="m7 15 4-4 3 3 5-6"/>',
  },
  {
    es: ["Guías, mapas y mods con un clic", "El panel descarga el contenido nuevo y comprueba cada archivo. Una guía nueva no te obliga a reinstalar nada."],
    en: ["Guides, maps and mods in one click", "The panel downloads new content and verifies every file. A new guide never makes you reinstall anything."],
    d: '<path d="M12 3v12m0 0 5-5m-5 5-5-5M4 19h16"/>',
  },
  {
    es: ["Tus datos son tuyos", "Sin cuentas ni servidores: el historial y los ajustes viven en tu PC. Funciona sin conexión."],
    en: ["Your data is yours", "No accounts, no servers: your history and settings live on your PC. Works offline."],
    d: '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>',
  },
  {
    es: ["En español y en inglés", "El panel, los pasos de las guías y la tarjeta de la partida. La primera vez usa el idioma de Windows."],
    en: ["In English and Spanish", "The panel, the guide steps and the in-game card. The first time it uses your Windows language."],
    d: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.5 3 14.5 0 18M12 3c-3 3.5-3 14.5 0 18"/>',
  },
];
---
<section class="seccion panel-sec" data-panel>
  <div class="contenedor">
    <div class="cab" data-aparece>
      <span class="antetitulo"><T es="El panel" en="The panel" /></span>
      <h2><T es="Mira cómo mejoras" en="Watch yourself improve" /></h2>
      <p class="lead">
        <T
          es="Al estilo de las apps compañeras de los juegos competitivos: se queda en la bandeja, no se pone encima del juego y lo tiene todo a mano."
          en="In the style of companion apps for competitive games: it lives in the tray, never covers the game and keeps everything at hand."
        />
      </p>
    </div>

    <div class="ventana" data-ventana>
      <div class="v-barra">
        <span class="v-titulo"><img src="/favicon.svg" alt="" width="16" height="16" /> AoE2 Coaching</span>
        <span class="v-botones"><i></i><i></i><i></i></span>
      </div>
      <div class="v-cuerpo">
        <aside class="v-lado">
          {menu.map((m, i) => (
            <span class={`v-item ${i === 1 ? "activo" : ""}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={m.d} />
              <T es={m.es} en={m.en} />
            </span>
          ))}
        </aside>
        <div class="v-contenido">
          <div class="v-cab">
            <div>
              <div class="v-guia">Fast Castle 27+2</div>
              <div class="v-sub"><T es="Tiempo hasta Castillos · últimas 12 partidas" en="Time to Castle Age · last 12 games" /></div>
            </div>
            <span class="v-abrir"><T es="Abrir AoE2" en="Launch AoE2" /></span>
          </div>
          <div class="v-cifras">
            <div class="cifra"><span><T es="Partidas" en="Games" /></span><b data-contar="12">12</b></div>
            <div class="cifra"><span><T es="Mejor marca" en="Best time" /></span><b>16:12</b></div>
            <div class="cifra"><span><T es="Media (10)" en="Average (10)" /></span><b>17:24 <em>−0:48</em></b></div>
            <div class="cifra"><span><T es="Completadas" en="Completed" /></span><b><span data-contar="83">83</span>%</b></div>
          </div>
          <div class="v-grafico">
            <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
              <defs>
                <linearGradient id="g-area" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#3D8FF5" stop-opacity="0.35" />
                  <stop offset="1" stop-color="#3D8FF5" stop-opacity="0" />
                </linearGradient>
              </defs>
              {[0.25, 0.5, 0.75].map((f) => <line x1="0" x2={W} y1={H * f} y2={H * f} class="rejilla" />)}
              <line x1="0" x2={W} y1={meta} y2={meta} class="meta" />
              <path d={area} fill="url(#g-area)" class="area" data-area />
              <path d={linea} class="linea" data-linea pathLength="1" />
              {tiempos.map((v, i) => <circle cx={px(i)} cy={py(v)} r="3.5" class="punto" data-punto-g />)}
            </svg>
            <span class="meta-etq"><T es="Referencia 15:55" en="Benchmark 15:55" /></span>
          </div>
        </div>
      </div>
    </div>

    <div class="extras">
      {extras.map((e) => (
        <article class="extra" data-aparece>
          <span class="extra-icono">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={e.d} />
          </span>
          <h3><T es={e.es[0]} en={e.en[0]} /></h3>
          <p><T es={e.es[1]} en={e.en[1]} /></p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .panel-sec {
    background: var(--fondo-2);
    overflow: hidden;
  }
  .cab {
    text-align: center;
  }
  .cab .lead {
    margin-inline: auto;
  }
  .ventana {
    margin: 70px auto 0;
    max-width: 960px;
    border-radius: 14px;
    background: #0d1016;
    box-shadow:
      var(--sombra),
      0 0 120px -30px rgba(61, 143, 245, 0.35);
    overflow: hidden;
    transform-origin: 50% 0;
  }
  .v-barra {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 36px;
    padding: 0 14px;
    background: #090b10;
    border-bottom: 1px solid var(--borde);
    font-size: 12.5px;
    color: var(--secundario);
  }
  .v-titulo {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .v-botones {
    display: flex;
    gap: 18px;
  }
  .v-botones i {
    width: 10px;
    height: 1.5px;
    background: var(--apagado);
  }
  .v-botones i:nth-child(2) {
    height: 10px;
    background: none;
    border: 1.5px solid var(--apagado);
  }
  .v-cuerpo {
    display: grid;
    grid-template-columns: 190px 1fr;
    min-height: 400px;
  }
  .v-lado {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 16px 10px;
    border-right: 1px solid var(--borde);
    background: rgba(255, 255, 255, 0.015);
  }
  .v-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    border-radius: 9px;
    font-size: 14px;
    color: var(--apagado);
  }
  .v-item svg {
    width: 18px;
  }
  .v-item.activo {
    color: var(--texto);
    background: rgba(94, 164, 255, 0.12);
    box-shadow: inset 2px 0 0 var(--acento);
  }
  .v-contenido {
    padding: 22px 24px;
    min-width: 0;
  }
  .v-cab {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }
  .v-guia {
    font-size: 19px;
    font-weight: 700;
  }
  .v-sub {
    font-size: 13px;
    color: var(--apagado);
  }
  .v-abrir {
    padding: 7px 14px;
    border-radius: 8px;
    background: var(--acento);
    color: #06121f;
    font-size: 13px;
    font-weight: 650;
    white-space: nowrap;
  }
  .v-cifras {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-top: 18px;
  }
  .cifra {
    padding: 12px 14px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--borde);
  }
  .cifra > span {
    display: block;
    font-size: 12px;
    color: var(--apagado);
  }
  .cifra b {
    font-size: 21px;
    font-variant-numeric: tabular-nums;
  }
  .cifra em {
    font-style: normal;
    font-size: 12.5px;
    color: var(--bien);
    font-weight: 650;
  }
  .v-grafico {
    position: relative;
    margin-top: 16px;
    padding: 14px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid var(--borde);
  }
  .v-grafico svg {
    width: 100%;
    height: 180px;
    overflow: visible;
  }
  .rejilla {
    stroke: rgba(255, 255, 255, 0.06);
  }
  .meta {
    stroke: var(--bien);
    stroke-dasharray: 4 5;
    opacity: 0.6;
  }
  .meta-etq {
    position: absolute;
    right: 18px;
    bottom: 6px;
    font-size: 11.5px;
    color: var(--bien);
  }
  .linea {
    fill: none;
    stroke: #3d8ff5;
    stroke-width: 2.5;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .punto {
    fill: #0d1016;
    stroke: #3d8ff5;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
    opacity: 0;
  }
  .area {
    opacity: 0;
  }

  .extras {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-top: 70px;
  }
  .extra {
    padding: 26px 22px;
    border-radius: var(--radio);
    border: 1px solid var(--borde);
    background: var(--tarjeta);
    transition:
      border-color 0.3s,
      transform 0.3s,
      background 0.3s;
  }
  .extra:hover {
    border-color: rgba(199, 157, 99, 0.4);
    background: var(--tarjeta-2);
  }
  .extra-icono {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: 18px;
    border-radius: 12px;
    background: rgba(199, 157, 99, 0.12);
    color: var(--dorado-claro);
  }
  .extra-icono svg {
    width: 22px;
  }
  .extra h3 {
    font-size: 17.5px;
  }
  .extra p {
    margin: 8px 0 0;
    color: var(--secundario);
    font-size: 15px;
    line-height: 1.55;
  }

  @media (max-width: 960px) {
    .extras {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 720px) {
    .v-cuerpo {
      grid-template-columns: 1fr;
    }
    .v-lado {
      flex-direction: row;
      overflow-x: auto;
      border-right: 0;
      border-bottom: 1px solid var(--borde);
      padding: 8px;
      scrollbar-width: none;
    }
    .v-item {
      flex: none;
    }
    .v-cifras {
      grid-template-columns: 1fr 1fr;
    }
    .v-contenido {
      padding: 16px;
    }
    .extras {
      grid-template-columns: 1fr;
    }
  }
</style>
