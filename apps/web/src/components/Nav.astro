---
import T from "./T.astro";
import { URL_REPO } from "../lib/contenido";

const enlaces = [
  { id: "como-funciona", es: "Cómo funciona", en: "How it works" },
  { id: "guias", es: "Guías", en: "Guides" },
  { id: "mapas", es: "Mapas", en: "Maps" },
  { id: "mods", es: "MODs", en: "MODs" },
  { id: "preguntas", es: "Preguntas", en: "FAQ" },
];
---
<header class="nav" data-nav>
  <div class="nav-barra">
    <a class="marca" href="#inicio" aria-label="AoE2 Coaching">
      <img src="/favicon.svg" alt="" width="34" height="34" />
      <span>AoE2<b>C</b></span>
    </a>

    <nav class="nav-enlaces" aria-label="Secciones">
      {enlaces.map((e) => (
        <a href={`#${e.id}`} data-enlace={e.id}><T es={e.es} en={e.en} /></a>
      ))}
    </nav>

    <div class="nav-acciones">
      <button class="idioma" type="button" data-idioma aria-label="Cambiar idioma / Change language">
        <span data-l="es">ES</span><span data-l="en">EN</span>
      </button>
      <a class="nav-github" href={URL_REPO} target="_blank" rel="noopener" aria-label="GitHub">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
      </a>
      <a class="boton boton-principal nav-descargar" href="#descargar" data-descarga>
        <T es="Descargar" en="Download" />
      </a>
      <button class="menu" type="button" data-menu aria-label="Menú" aria-expanded="false">
        <span></span><span></span>
      </button>
    </div>
  </div>
  <div class="nav-progreso" data-progreso></div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding: 14px 16px 0;
    transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .nav.oculta {
    transform: translateY(-110%);
  }
  .nav-barra {
    display: flex;
    align-items: center;
    gap: 20px;
    width: min(var(--ancho), 100%);
    margin-inline: auto;
    padding: 8px 8px 8px 16px;
    border-radius: 999px;
    border: 1px solid transparent;
    transition:
      background 0.4s,
      border-color 0.4s,
      box-shadow 0.4s;
  }
  .nav.solida .nav-barra {
    background: rgba(12, 15, 22, 0.72);
    border-color: var(--borde);
    box-shadow: 0 20px 50px -20px rgba(0, 0, 0, 0.8);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    backdrop-filter: blur(16px) saturate(1.4);
  }
  .marca {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--titulo);
    font-weight: 700;
    font-size: 21px;
    letter-spacing: 0.04em;
  }
  .marca b {
    color: var(--dorado);
  }
  .nav-enlaces {
    display: flex;
    gap: 4px;
    margin-inline: auto;
  }
  .nav-enlaces a {
    position: relative;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 520;
    color: var(--secundario);
    transition:
      color 0.2s,
      background 0.2s;
  }
  .nav-enlaces a:hover,
  .nav-enlaces a.activo {
    color: var(--texto);
    background: var(--tarjeta-2);
  }
  .nav-acciones {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }
  .nav-enlaces + .nav-acciones {
    margin-left: 0;
  }
  .idioma {
    display: flex;
    padding: 3px;
    border-radius: 999px;
    border: 1px solid var(--borde);
    background: var(--tarjeta);
    cursor: pointer;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .idioma span {
    padding: 5px 9px;
    border-radius: 999px;
    color: var(--apagado);
    transition:
      background 0.25s,
      color 0.25s;
  }
  :global(html[lang="es"]) .idioma [data-l="es"],
  :global(html[lang="en"]) .idioma [data-l="en"] {
    background: var(--texto);
    color: var(--fondo);
  }
  .nav-github {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: var(--secundario);
    transition:
      color 0.2s,
      background 0.2s;
  }
  .nav-github:hover {
    color: var(--texto);
    background: var(--tarjeta-2);
  }
  .nav-github svg {
    width: 21px;
  }
  .nav-descargar {
    min-height: 42px;
    padding: 0 20px;
    font-size: 15px;
  }
  .nav-progreso {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 100%;
    transform-origin: 0 50%;
    transform: scaleX(0);
    background: linear-gradient(90deg, var(--granate), var(--dorado));
  }
  .menu {
    display: none;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid var(--borde);
    background: var(--tarjeta);
    cursor: pointer;
    position: relative;
  }
  .menu span {
    position: absolute;
    left: 13px;
    right: 13px;
    height: 1.6px;
    background: currentColor;
    transition: transform 0.3s;
  }
  .menu span:first-child {
    top: 17px;
  }
  .menu span:last-child {
    top: 23px;
  }
  .nav.abierta .menu span:first-child {
    transform: translateY(3px) rotate(45deg);
  }
  .nav.abierta .menu span:last-child {
    transform: translateY(-3px) rotate(-45deg);
  }

  @media (max-width: 960px) {
    .nav-enlaces {
      position: absolute;
      top: 72px;
      left: 16px;
      right: 16px;
      flex-direction: column;
      padding: 10px;
      border-radius: 22px;
      border: 1px solid var(--borde);
      background: rgba(12, 15, 22, 0.95);
      -webkit-backdrop-filter: blur(16px);
      backdrop-filter: blur(16px);
      opacity: 0;
      pointer-events: none;
      transform: translateY(-8px);
      transition:
        opacity 0.25s,
        transform 0.25s;
    }
    .nav.abierta .nav-enlaces {
      opacity: 1;
      pointer-events: auto;
      transform: none;
    }
    .nav-enlaces a {
      padding: 12px 16px;
      font-size: 17px;
    }
    .menu {
      display: block;
    }
    .nav-github {
      display: none;
    }
  }
  @media (max-width: 520px) {
    .nav-descargar {
      display: none;
    }
    .marca span {
      font-size: 19px;
    }
  }
</style>
