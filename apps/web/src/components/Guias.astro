---
import T from "./T.astro";
import { NIVELES, type Guia, type Mapa } from "../lib/contenido";
import { icono } from "../lib/iconos";

interface Props {
  guias: Guia[];
  mapas: Mapa[];
}
const { guias, mapas } = Astro.props;
const nombreMapa = (id: string) => mapas.find((m) => m.id === id)?.nombre ?? id;
---
<section class="seccion guias" id="guias">
  <div class="contenedor">
    <div class="cab" data-aparece>
      <span class="antetitulo"><T es="Guías" en="Guides" /></span>
      <h2><T es="Aperturas probadas, paso a paso" en="Proven openings, step by step" /></h2>
      <p class="lead">
        <T
          es="Cada guía sigue lo que pasa en tu partida: cuenta casas, aldeanos por recurso y tecnologías, y avanza sola cuando cumples el paso."
          en="Each guide follows what happens in your game: it counts houses, villagers per resource and technologies, and moves on by itself when you complete a step."
        />
      </p>
    </div>

    <div class="lista">
      {guias.map((g) => (
        <article class="guia" data-aparece data-inclinar>
          <div class="guia-brillo"></div>
          <div class="guia-cab">
            <span class={`chip nivel-${g.nivel}`}>
              <i></i><T es={NIVELES[g.nivel]?.es ?? g.nivel} en={NIVELES[g.nivel]?.en ?? g.nivel} />
            </span>
            <span class="version">v{g.version}</span>
          </div>
          <h3>{g.nombre}</h3>
          <p class="desc"><T es={g.descripcion.es} en={g.descripcion.en} /></p>

          <dl class="datos">
            <div><dt><T es="Pasos" en="Steps" /></dt><dd>{g.pasos.length}</dd></div>
            <div><dt><T es="Meta" en="Goal" /></dt><dd>{g.meta}</dd></div>
            <div><dt><T es="Mapas" en="Maps" /></dt><dd>{g.mapas.length}</dd></div>
          </dl>

          <div class="mapas">
            {g.mapas.map((m) => <span class="chip">{nombreMapa(m)}</span>)}
          </div>

          <details class="ver-pasos">
            <summary>
              <T es="Ver los pasos" en="See the steps" />
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </summary>
            <ol>
              {g.pasos.map((p) => (
                <li>
                  <span class="p-icono" set:html={icono(p.icono)} />
                  <span class="p-titulo"><T es={p.titulo.es} en={p.titulo.en} /></span>
                  <span class="p-hora">{p.referencia}</span>
                </li>
              ))}
            </ol>
          </details>
        </article>
      ))}

      <article class="guia proxima" data-aparece>
        <div class="proxima-icono">+</div>
        <h3><T es="Más guías en camino" en="More guides on the way" /></h3>
        <p class="desc">
          <T
            es="Las guías nuevas llegan al panel sin actualizar la app. ¿Quieres una apertura concreta? Pídela en GitHub."
            en="New guides reach the panel without updating the app. Want a specific opening? Ask for it on GitHub."
          />
        </p>
      </article>
    </div>
  </div>
</section>

<style>
  .guias {
    background: var(--fondo-2);
  }
  .lista {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 60px;
    align-items: start;
  }
  .guia {
    position: relative;
    padding: 28px;
    border-radius: 22px;
    border: 1px solid var(--borde);
    background: linear-gradient(170deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.015));
    overflow: hidden;
    transform-style: preserve-3d;
    transition:
      border-color 0.3s,
      box-shadow 0.3s;
  }
  .guia:hover {
    border-color: rgba(199, 157, 99, 0.45);
    box-shadow: 0 30px 70px -30px rgba(0, 0, 0, 0.8);
  }
  .guia-brillo {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(400px circle at var(--mx, 50%) var(--my, 0%), rgba(199, 157, 99, 0.13), transparent 50%);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .guia:hover .guia-brillo {
    opacity: 1;
  }
  .guia-cab {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .chip i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }
  .nivel-facil {
    color: var(--bien);
  }
  .nivel-media {
    color: var(--atencion);
  }
  .nivel-dificil {
    color: var(--mal);
  }
  .version {
    font-size: 13px;
    color: var(--apagado);
    font-variant-numeric: tabular-nums;
  }
  .guia h3 {
    margin-top: 22px;
    font-family: var(--titulo);
    font-size: 27px;
  }
  .desc {
    margin: 12px 0 0;
    color: var(--secundario);
    font-size: 15.5px;
  }
  .datos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 24px 0 0;
    border-block: 1px solid var(--borde);
  }
  .datos div {
    padding: 14px 0;
  }
  .datos div + div {
    padding-left: 16px;
    border-left: 1px solid var(--borde);
  }
  dt {
    font-size: 12px;
    color: var(--apagado);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  dd {
    margin: 2px 0 0;
    font-size: 22px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .mapas {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 18px;
  }
  .ver-pasos {
    margin-top: 20px;
  }
  summary {
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    font-size: 15px;
    color: var(--dorado-claro);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary svg {
    width: 16px;
    transition: transform 0.3s;
  }
  details[open] summary svg {
    transform: rotate(180deg);
  }
  .ver-pasos ol {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .ver-pasos li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 8px;
    border-radius: 8px;
    font-size: 14px;
    color: var(--secundario);
  }
  .ver-pasos li:hover {
    background: var(--tarjeta-2);
    color: var(--texto);
  }
  .p-icono {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    flex: none;
    border-radius: 7px;
    background: rgba(94, 164, 255, 0.12);
    color: #9cc7ff;
  }
  .p-icono :global(svg) {
    width: 15px;
  }
  .p-hora {
    margin-left: auto;
    color: var(--apagado);
    font-variant-numeric: tabular-nums;
  }
  .proxima {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100%;
    border-style: dashed;
    background: transparent;
  }
  .proxima-icono {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1px dashed var(--borde-2);
    font-size: 26px;
    color: var(--dorado);
  }
  .proxima h3 {
    font-size: 22px;
  }
  @media (max-width: 1000px) {
    .lista {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 680px) {
    .lista {
      grid-template-columns: 1fr;
    }
    .guia {
      padding: 22px;
    }
  }
</style>
